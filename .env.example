# Public HTTPS address that users open in their browser. Do not include a trailing slash.
PUBLIC_BASE_URL=https://tasks.example.com

# Optional frontend error reporting. Leave empty to disable it.
VITE_SENTRY_DSN=

# Generate with: openssl rand -base64 36
# Use URL-safe characters because it is embedded in DATABASE_URL by Docker Compose.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-password

# Required for built-in account verification and password resets in production.
SMTP_URL=smtps://username:password@mail.example.com:465
MAIL_FROM=WeekToDoOnline <noreply@example.com>

# Built-in email/password registration is disabled by default. Set to true only
# while you want users to be able to create new accounts.
ALLOW_REGISTRATION=false

# Optional secondary login provider. Leave all three values empty to disable OIDC.
OIDC_ISSUER_URL=https://auth.example.com/application/o/weektodoonline/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
